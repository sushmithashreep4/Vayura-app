# ============================================================
# VAYURA Backend Environment Variables
# Copy to .env and configure before running
# NEVER commit .env to version control
# ============================================================

# ── PayPal Sandbox Credentials ──
# Get from https://developer.paypal.com/developer/applications
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# ── AI Integration (Optional) ──
# Supports OpenAI-compatible APIs (OpenAI, Groq, Together AI, etc.)
AI_API_KEY=your_ai_api_key
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_ENABLED=false

# ── MySQL Database (for production; H2 used by default) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vayura
DB_USERNAME=vayura_user
DB_PASSWORD=your_secure_password
